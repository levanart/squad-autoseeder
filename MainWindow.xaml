<Window x:Class="Autoseeder.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Autoseeder.Client.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="5thMR · Автосидер" Width="1080" Height="760" MinWidth="860" MinHeight="620"
        Icon="Assets/app.ico"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Storyboard x:Key="EntranceStoryboard">
      <DoubleAnimation Storyboard.TargetName="HeroSection" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.36" BeginTime="0:0:0.04">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="HeroTranslate" Storyboard.TargetProperty="Y"
                       From="12" To="0" Duration="0:0:0.42" BeginTime="0:0:0.04">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>

      <DoubleAnimation Storyboard.TargetName="ControlPanel" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.38" BeginTime="0:0:0.13">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ControlTranslate" Storyboard.TargetProperty="Y"
                       From="14" To="0" Duration="0:0:0.44" BeginTime="0:0:0.13">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>

      <DoubleAnimation Storyboard.TargetName="ServersPanel" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.22">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ServersTranslate" Storyboard.TargetProperty="Y"
                       From="16" To="0" Duration="0:0:0.48" BeginTime="0:0:0.22">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>

      <DoubleAnimation Storyboard.TargetName="LogsPanel" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.29">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="LogsTranslate" Storyboard.TargetProperty="Y"
                       From="16" To="0" Duration="0:0:0.48" BeginTime="0:0:0.29">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource EntranceStoryboard}" />
    </EventTrigger>
  </Window.Triggers>

  <Grid Background="{StaticResource PageBrush}">
    <Image Source="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.9"
           IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
      <Image.Effect><BlurEffect Radius="7" KernelType="Gaussian" RenderingBias="Quality" /></Image.Effect>
    </Image>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#9405070B" />
          <GradientStop Color="#C207090E" Offset="0.55" />
          <GradientStop Color="#E0090A0D" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Ellipse Width="620" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-230,0,0" IsHitTestVisible="False">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#32FF7A1A"/><GradientStop Color="#00FF7A1A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      <Ellipse.Effect><BlurEffect Radius="70" /></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="500" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-250,-240" IsHitTestVisible="False">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#18FFB15C"/><GradientStop Color="#00FF7A1A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      <Ellipse.Effect><BlurEffect Radius="80" /></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="420" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="300,-160,0,0" IsHitTestVisible="False" Opacity="0.75">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#16FF7A1A"/><GradientStop Color="#00FF7A1A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      <Ellipse.Effect><BlurEffect Radius="92" /></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="360" Height="240" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,-150" IsHitTestVisible="False" Opacity="0.55">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#12FFB15C"/><GradientStop Color="#00FF7A1A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      <Ellipse.Effect><BlurEffect Radius="84" /></Ellipse.Effect>
    </Ellipse>

    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#B30A0C11" BorderBrush="#1CFFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBarMouseDown">
        <Grid Margin="22,0,10,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
              <TextBlock Text="5th" Foreground="#FF17100B" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="5thMR" FontSize="14" FontWeight="ExtraBold" />
              <TextBlock Text="A U T O S E E D E R" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="MinimizeClick" />
            <Button x:Name="MaximizeButton" Content="□" ToolTip="Развернуть" Style="{StaticResource WindowButtonStyle}" Click="MaximizeClick" />
            <Button Content="✕" Style="{StaticResource WindowButtonStyle}" Click="CloseClick" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    PanningMode="VerticalOnly">
        <Grid Margin="28,24,28,28" MinWidth="760">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/>
            <RowDefinition Height="3*" MinHeight="300"/><RowDefinition Height="14"/><RowDefinition Height="Auto" MinHeight="235"/>
            <RowDefinition Height="14"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid x:Name="HeroSection" Opacity="0">
            <Grid.RenderTransform><TranslateTransform x:Name="HeroTranslate" /></Grid.RenderTransform>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="АВТОСИДЕР" Style="{StaticResource EyebrowStyle}" />
              <TextBlock Text="Сервер всегда под контролем" FontSize="30" FontWeight="ExtraBold" Margin="0,7,0,0" />
              <TextBlock Text="Следим за онлайном и подключаем к серверу, которому нужен сид." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="16,12" CornerRadius="14" VerticalAlignment="Center" Margin="24,0,0,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="AccountDot" Width="8" Height="8" Fill="#FF676B74" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel>
                  <TextBlock x:Name="AccountText" Text="Steam не подключён" FontSize="12" FontWeight="Bold" />
                  <TextBlock x:Name="AccountSubtext" Text="Авторизуйтесь для запуска" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="LogoutButton" Content="↪" ToolTip="Выйти из аккаунта"
                        Click="LogoutClick" Visibility="Collapsed" Style="{StaticResource WindowButtonStyle}"
                        Width="34" Height="34" Margin="12,0,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <Border x:Name="ControlPanel" Grid.Row="2" Style="{StaticResource PanelStyle}" Opacity="0">
            <Border.RenderTransform><TranslateTransform x:Name="ControlTranslate" /></Border.RenderTransform>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Effect="{DynamicResource AccentLineGlow}" />
              <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Управление" FontSize="18" FontWeight="Bold" />
                  <Border x:Name="ActiveBadge" Visibility="Collapsed" Margin="12,0,0,0" Padding="10,4" CornerRadius="7" Background="#1529D67C" BorderBrush="#5529D67C" BorderThickness="1">
                    <TextBlock Text="А К Т И В Е Н" Foreground="#FF4AE697" FontSize="9" FontWeight="ExtraBold" />
                  </Border>
                </StackPanel>
                <TextBlock x:Name="StateText" Text="Автосидер выключен" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" />
                <TextBlock x:Name="TargetText" Text="Войдите через Steam, чтобы начать" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button x:Name="LoginButton" Content="Войти через Steam" Click="LoginClick" Style="{StaticResource PrimaryButtonStyle}" />
                <Button x:Name="RefreshButton" Content="Обновить" Click="RefreshClick" IsEnabled="False" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Visibility="Collapsed" />
                <Button x:Name="ToggleButton" Content="Запустить" Click="ToggleClick" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" MinWidth="124" Visibility="Collapsed" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.35*"/><ColumnDefinition Width="14"/>
              <ColumnDefinition Width="0.95*"/><ColumnDefinition Width="14"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ServersPanel" Style="{StaticResource PanelStyle}" Padding="20" Opacity="0">
              <Border.RenderTransform><TranslateTransform x:Name="ServersTranslate" /></Border.RenderTransform>
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,16">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="17" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,1,10,0" />
                    <TextBlock Text="Серверы" FontSize="17" FontWeight="Bold" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="L I V E" Foreground="{StaticResource AccentSoftBrush}" FontSize="9" FontWeight="ExtraBold" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl x:Name="ServersList" Focusable="False" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}" BorderThickness="1"
                              CornerRadius="14" Padding="16,14" Margin="0,0,0,9">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Top" Margin="0,5,12,0">
                            <Ellipse.Effect><DropShadowEffect Color="{Binding StatusColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.7" /></Ellipse.Effect>
                          </Ellipse>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="18,0,0,0">
                            <TextBlock Text="{Binding PlayerLabel}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding QueueLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" FontSize="11" HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="4" Height="17" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,1,10,0" />
                  <TextBlock Text="Таймер" FontSize="17" FontWeight="Bold" />
                </StackPanel>
                <TextBlock x:Name="ShutdownStatusText" Text="Таймер не запланирован"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="14,7,0,14"
                           TextWrapping="Wrap"/>

                <Border Style="{StaticResource SegmentedControlStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="ShutdownPcTimerRadio" Content="Выключить ПК" GroupName="TimerAction"
                                 IsChecked="True" Style="{StaticResource SegmentRadioStyle}"/>
                    <RadioButton x:Name="CloseSquadTimerRadio" Grid.Column="1" Content="Закрыть Squad"
                                 GroupName="TimerAction" Style="{StaticResource SegmentRadioStyle}"/>
                  </Grid>
                </Border>

                <TextBlock Text="ЧЕРЕЗ НЕСКОЛЬКО МИНУТ" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ShutdownDelayMinutesText" Text="60" ToolTip="Задержка в минутах"
                           Style="{StaticResource DarkTextBoxStyle}"/>
                  <Button Grid.Column="2" Content="Запустить" Click="ScheduleShutdownDelayClick"
                          Style="{StaticResource PrimaryButtonStyle}" Padding="14,0"/>
                </Grid>

                <TextBlock Text="ИЛИ К ТОЧНОМУ ВРЕМЕНИ" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                  <Border Background="#B3090B10" BorderBrush="#2FFFFFFF" BorderThickness="1"
                          CornerRadius="9" ClipToBounds="True" Height="40" VerticalAlignment="Center">
                    <DatePicker x:Name="ShutdownDatePicker" Style="{StaticResource DarkDatePickerStyle}"
                                VerticalAlignment="Center"/>
                  </Border>
                  <TextBox x:Name="ShutdownTimeText" Grid.Column="2" Style="{StaticResource DarkTextBoxStyle}"
                           HorizontalContentAlignment="Center" ToolTip="Время в формате ЧЧ:ММ"/>
                </Grid>
                <Button Content="Запланировать" Click="ScheduleShutdownClick" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,9,0,0"/>
                <Button x:Name="CancelShutdownButton" Content="Отменить таймер" Click="CancelShutdownClick"
                        Style="{StaticResource DangerButtonStyle}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border x:Name="LogsPanel" Grid.Column="4" Style="{StaticResource PanelStyle}" Padding="20"
                    Opacity="0" Height="393" VerticalAlignment="Top">
              <Border.RenderTransform><TranslateTransform x:Name="LogsTranslate" /></Border.RenderTransform>
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,16">
                  <Border Width="4" Height="17" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,1,10,0" />
                  <TextBlock Text="Журнал" FontSize="17" FontWeight="Bold" />
                </StackPanel>
                <Border Background="#66000000" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="8">
                  <ListBox x:Name="LogsList" Background="Transparent" BorderThickness="0"
                           Foreground="#FFADB0B8" FontFamily="Cascadia Code, Consolas" FontSize="11"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                  </ListBox>
                </Border>
              </DockPanel>
            </Border>
          </Grid>

          <Border Grid.Row="6" Style="{StaticResource PanelStyle}" Padding="20">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Border Width="4" Height="17" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,1,10,0" />
                  <TextBlock Text="Система" FontSize="17" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="ОБНОВЛЕНИЕ КАЖДЫЕ 2 СЕК." Foreground="{StaticResource MutedBrush}"
                           FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
              </Grid>

              <ItemsControl x:Name="SystemMetricsList" Grid.Row="2">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="292" Height="184" Background="#0CFFFFFF" BorderBrush="#24FFFFFF"
                            BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,10,10">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                     FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" Margin="0,0,86,0"/>
                          <TextBlock Text="{Binding Secondary}" HorizontalAlignment="Right"
                                     Foreground="{Binding SecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,4">
                          <TextBlock Text="{Binding Value}" FontSize="23" FontWeight="ExtraBold"/>
                          <TextBlock Text=" загрузка" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                     VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                        </StackPanel>
                        <controls:Sparkline Grid.Row="2" Values="{Binding Values}" Stroke="{Binding Stroke}"
                                            Maximum="100" Unit="%" MinHeight="82"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
